# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
[mergetool]
        keepBackup = false
[help]
	autocorrect = 10
[push]
        default = current
[rebase]
        autosquash = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[commit]
        gpgsign = true
[gpg]
        format = ssh
[rerere]
	enabled = true
[fetch]
        prune = true
	pruneTags = true
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
